          "y": 86,
          "size": 4.5,
          "text": "cache: the next request never leaves the device",
          "draw": 1,
          "color": "#2a9d4b",
          "at": "cache"
        }
      ]
    },
    {
      "id": "recap",
      "chapter": "Recap",
      "narration": "So, latency is the time a round trip takes. Distance, hops, handshakes and server time all add to it. Shorten the distance, cut the trips, and your app will feel instant.",
      "elements": [
        {
          "type": "text",
          "x": 50,
          "y": 9,
          "size": 8,
          "text": "Latency = one round trip",
          "draw": 0.8,
          "at": "latency"
        },
        {
          "type": "list",
          "x": 10,
          "y": 34,
          "size": 6,
          "items": [
            "distance",
            "hops",
            "handshakes",
            "server time"
          ],
          "draw": 2,
          "at": "distance"
        },
        {
          "type": "image",
          "name": "gen/latency/button",
          "x": 72,
          "y": 50,
          "w": 40,
          "draw": 1.6,
          "at": "add"
        },
        {
          "type": "text",
          "x": 50,
          "y": 88,
          "size": 6,
          "text": "shorten the distance, cut the trips",
          "draw": 1,
          "color": "#2a9d4b",
          "at": "shorten"
        }
      ]
    }
  ]
}
