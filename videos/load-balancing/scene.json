{
  "version": 1,
  "title": "Load balancing: how big websites handle huge crowds",
  "type": "explainer",
  "scenes": [
    {
      "id": "hook",
      "narration": "A popular website can get thousands of visitors every second. No single server can answer them all. When too many people arrive at once, pages slow down, then fail. So how do big sites stay up? They use a load balancer.",
      "elements": [
        {
          "type": "image",
          "name": "gen/load-balancing/visitors",
          "x": 30,
          "y": 50,
          "w": 36,
          "draw": 1,
          "at": "visitors"
        },
        {
          "type": "text",
          "x": 30,
          "y": 14,
          "size": 4.5,
          "text": "thousands every second",
          "draw": 0.8,
          "at": "second",
          "color": "#1e6fd9"
        },
        {
          "type": "image",
          "name": "gen/latency/server",
