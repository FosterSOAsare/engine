    {
      "id": "address",
      "chapter": "What a load balancer is",
      "narration": "To you, the website has one address. Behind it, there may be ten servers, or ten thousand. You never see which one answered.",
      "elements": [
        {
          "type": "text",
          "x": 50,
          "y": 9,
