          "start": 3.2
        },
        {
          "type": "arrow",
          "from": "ny",
          "to": "london",
          "draw": 0.6,
          "head": "both",
          "label": "5,500 km",
          "color": "#1e6fd9",
          "start": 6.1
        },
        {
          "type": "text",
          "text": "light in fiber: ~200 km per millisecond",
          "x": 50,
          "y": 74,
          "size": 5,
          "draw": 1.0,
          "start": 8.8
        },
        {
          "type": "text",
