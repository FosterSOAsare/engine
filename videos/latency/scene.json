          "color": "#c0392b",
          "start": 11.4
        }
      ]
    },
    {
      "id": "closer",
      "duration": 13.1,
      "narration": "You can buy a faster CPU. You can buy a bigger server. But you cannot buy a faster speed of light. Distance is a cost you can only avoid by moving closer.",
      "elements": [
        {
          "type": "text",
          "text": "Faster CPU",
          "x": 38,
          "y": 26,
          "size": 7,
          "draw": 1.0,
          "start": 0.3
        },
        {
          "type": "icon",
