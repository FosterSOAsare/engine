    {
      "id": "physics",
      "duration": 13.2,
      "narration": "That last one is not a hardware problem. It is physics. Light in a fiber cable covers about two hundred kilometres every millisecond, so New York to London and back can never take less than about fifty six milliseconds.",
      "elements": [
        {
          "type": "icon",
          "name": "map-pin",
          "x": 14,
          "y": 40,
          "size": 14,
          "draw": 0.8,
