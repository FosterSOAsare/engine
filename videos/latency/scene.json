          "x": 36,
          "y": 22,
          "size": 5,
          "draw": 0.8,
          "start": 4.63
        },
        {
          "type": "text",
          "text": "1 second",
          "x": 74,
          "y": 22,
          "size": 6,
          "draw": 0.8,
          "color": "#1e6fd9",
          "id": "time0",
          "start": 6.7
        }
      ]
    },
    {
      "id": "ram",
