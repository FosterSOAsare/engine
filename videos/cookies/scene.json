          "id": "browser",
          "name": "gen/cookies/browser",
          "x": 18,
          "y": 46,
          "w": 26,
          "label": "your browser",
          "draw": 1.4,
          "at": "browser"
        },
        {
          "type": "image",
          "id": "note",
          "name": "gen/cookies/cookie",
          "x": 50,
          "y": 46,
          "w": 16,
